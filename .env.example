# Copy to .env (never commit .env). Load it with your host's secret manager or `node --env-file=.env src/server.js`.
NODE_ENV=production
PORT=3000
# REQUIRED in production: at least 32 random characters. Used to encrypt 2FA secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# MongoDB connection string. Use a replica set (MongoDB Atlas is one) so multi-step changes are atomic.
# Example: mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside that MongoDB deployment.
MONGODB_DB=cartitaz
# Private admin URL prefix (change it if you like; security does NOT depend on it being secret).
ADMIN_PATH=/control-center
# Set to 1 only when running behind exactly one trusted reverse proxy/load balancer (Render, Railway, Fly, Nginx, Caddy).
TRUST_PROXY=1
# Optional: your public origin, e.g. https://cartitaz.com (used for the admin Origin check if Host headers are rewritten).
PUBLIC_ORIGIN=
